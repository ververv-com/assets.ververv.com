{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ververv-app-sites",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "peviai.ververv.com",
      "custom_domain": true
    }
  ]
}
